{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/js/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts",
    "packages/js/*.config.ts",
    "packages/mcp/src/**/*.ts",
    "packages/mcp/*.config.ts"
  ]
}
