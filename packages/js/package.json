{
  "name": "algeria-wilayas-communes",
  "version": "2.0.0",
  "description": "Algeria administrative divisions as JSON and TypeScript — 69 wilayas, 585 daïras, 1541 communes (2026 reform) with Arabic, French and English names plus postal codes. Zero dependencies.",
  "keywords": [
    "algeria",
    "wilaya",
    "wilayas",
    "commune",
    "communes",
    "daira",
    "dairas",
    "postal-code",
    "zip-code",
    "algeria-cities",
    "administrative-divisions",
    "dataset",
    "open-data",
    "json",
    "dz",
    "algerie",
    "wilayas-algerie",
    "communes-algerie",
    "code-postal-algerie",
    "الجزائر"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "wilayas": [
        "./dist/wilayas.d.ts"
      ],
      "dairas": [
        "./dist/dairas.d.ts"
      ],
      "communes": [
        "./dist/communes.d.ts"
      ],
      "zod": [
        "./dist/zod.d.ts"
      ],
      "legacy": [
        "./dist/legacy.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./wilayas": {
      "types": {
        "import": "./dist/wilayas.d.ts",
        "require": "./dist/wilayas.d.cts"
      },
      "import": "./dist/wilayas.mjs",
      "require": "./dist/wilayas.cjs",
      "default": "./dist/wilayas.mjs"
    },
    "./dairas": {
      "types": {
        "import": "./dist/dairas.d.ts",
        "require": "./dist/dairas.d.cts"
      },
      "import": "./dist/dairas.mjs",
      "require": "./dist/dairas.cjs",
      "default": "./dist/dairas.mjs"
    },
    "./communes": {
      "types": {
        "import": "./dist/communes.d.ts",
        "require": "./dist/communes.d.cts"
      },
      "import": "./dist/communes.mjs",
      "require": "./dist/communes.cjs",
      "default": "./dist/communes.mjs"
    },
    "./zod": {
      "types": {
        "import": "./dist/zod.d.ts",
        "require": "./dist/zod.d.cts"
      },
      "import": "./dist/zod.mjs",
      "require": "./dist/zod.cjs",
      "default": "./dist/zod.mjs"
    },
    "./legacy": {
      "types": {
        "import": "./dist/legacy.d.ts",
        "require": "./dist/legacy.d.cts"
      },
      "import": "./dist/legacy.mjs",
      "require": "./dist/legacy.cjs",
      "default": "./dist/legacy.mjs"
    },
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "lint:publish": "publint --strict && attw --pack ."
  },
  "peerDependencies": {
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "license": "CC0-1.0",
  "author": "El Amin (https://el-amin.dev)",
  "homepage": "https://github.com/el-amin-dev/algeria-wilayas-communes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/el-amin-dev/algeria-wilayas-communes.git",
    "directory": "packages/js"
  },
  "bugs": {
    "url": "https://github.com/el-amin-dev/algeria-wilayas-communes/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "algeria-wilayas-communes": "./dist/cli.mjs"
  }
}
