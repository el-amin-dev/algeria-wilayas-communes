{
  "name": "algeria-wilayas-communes-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build:data": "tsx scripts/build-data.ts",
    "data:diff": "node scripts/data-diff.mjs",
    "build": "pnpm -F algeria-wilayas-communes build",
    "lint:publish": "pnpm -F algeria-wilayas-communes lint:publish",
    "pack:check": "node benchmarks/pack-check.mjs",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release:tag": "changeset tag",
    "bench": "node benchmarks/run.mjs",
    "bench:import": "node benchmarks/import-time.bench.mjs",
    "size": "size-limit",
    "size:why": "size-limit --why",
    "treeshake:proof": "node benchmarks/treeshake-fixture/assert-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest run --typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"*.{js,ts,json,yaml}\" .prettierrc \"scripts/**/*.ts\" \"tests/**/*.ts\" \"packages/js/src/**/*.ts\" \"packages/js/*.config.ts\" packages/js/tsconfig.json packages/js/package.json \"benchmarks/**/*.mjs\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"*.{js,ts,json,yaml}\" .prettierrc \"scripts/**/*.ts\" \"tests/**/*.ts\" \"packages/js/src/**/*.ts\" \"packages/js/*.config.ts\" packages/js/tsconfig.json packages/js/package.json \"benchmarks/**/*.mjs\" \"scripts/**/*.mjs\"",
    "validate:data": "python3 shared/validate.py"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "rollup-plugin-visualizer": "^7.1.1",
    "size-limit": "^13.0.3",
    "tinybench": "^6.1.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  }
}
