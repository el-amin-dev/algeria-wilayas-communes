{
  "name": "algeria-wilayas-communes-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build:data": "tsx scripts/build-data.ts",
    "build": "pnpm -F algeria-wilayas-communes build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest run --typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"*.{js,ts,json,yaml}\" .prettierrc \"scripts/**/*.ts\" \"tests/**/*.ts\" \"packages/js/src/**/*.ts\" packages/js/tsconfig.json",
    "format:check": "prettier --check \"*.{js,ts,json,yaml}\" .prettierrc \"scripts/**/*.ts\" \"tests/**/*.ts\" \"packages/js/src/**/*.ts\" packages/js/tsconfig.json",
    "validate:data": "python3 scripts/validate.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
